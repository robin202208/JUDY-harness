# 复制为 .env 并填写：
#   cp deploy/.env.example deploy/.env

# DeepSeek 官方 API 密钥（platform.deepseek.com 获取）。
# 使用本地/国产模型时随意填一个非空值即可。
DEEPSEEK_API_KEY=

# 模型端点基地址；留空 = DeepSeek 官方 API。
# 接入本地/国产模型（OpenAI 兼容端点）示例：
#   DEEPSEEK_BASE_URL=http://ollama:11434/v1     # 本地 Ollama
#   DEEPSEEK_BASE_URL=http://<vllm-host>:8000/v1 # 内网 vLLM
DEEPSEEK_BASE_URL=
